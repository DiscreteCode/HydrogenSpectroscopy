/* Hydrogen Quantum Spectroscopy -- dark scientific-instrument theme */

QWidget {
    background-color: #0a0e17;
    color: #c9d3e6;
    font-family: "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow, #centralWidget {
    background-color: #0a0e17;
}

/* --- Navigation sidebar --- */
#navSidebar {
    background-color: #0d1220;
    border-right: 1px solid #1c2436;
}

#navTitle {
    color: #f2f5fb;
    font-size: 15px;
    font-weight: 600;
    padding: 18px 16px 4px 16px;
}

#navSubtitle {
    color: #7c869c;
    font-size: 10px;
    padding: 0px 16px 14px 16px;
}

QPushButton#navButton {
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    color: #97a3ba;
    text-align: left;
    padding: 11px 16px;
    font-size: 13px;
    border-radius: 0px;
}

QPushButton#navButton:hover {
    background-color: #131a2b;
    color: #e7ecf7;
}

QPushButton#navButton:checked {
    background-color: #131a2b;
    color: #4fd1e8;
    border-left: 3px solid #4fd1e8;
    font-weight: 600;
}

/* --- Status bar --- */
QStatusBar {
    background-color: #0d1220;
    border-top: 1px solid #1c2436;
    color: #97a3ba;
    font-size: 11px;
}

/* --- Cards / panels --- */
QFrame#card {
    background-color: #0d1220;
    border: 1px solid #1c2436;
    border-radius: 10px;
}

QLabel#cardTitle {
    color: #7c869c;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

QLabel#statValue {
    color: #f2f5fb;
    font-size: 22px;
    font-weight: 600;
}

QLabel#statValueAccent {
    color: #4fd1e8;
    font-size: 26px;
    font-weight: 700;
}

QLabel#pageTitle {
    color: #f2f5fb;
    font-size: 20px;
    font-weight: 600;
    padding-bottom: 2px;
}

QLabel#pageSubtitle {
    color: #7c869c;
    font-size: 12px;
    padding-bottom: 10px;
}

QLabel#sectionHeader {
    color: #9d7ce8;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding-top: 6px;
}

/* --- Inputs --- */
QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit {
    background-color: #131a2b;
    border: 1px solid #262f47;
    border-radius: 6px;
    padding: 5px 8px;
    color: #e7ecf7;
    selection-background-color: #4f8fe8;
}

QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover {
    border: 1px solid #4f8fe8;
}

QComboBox QAbstractItemView {
    background-color: #131a2b;
    color: #e7ecf7;
    selection-background-color: #4f8fe8;
    border: 1px solid #262f47;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #262f47;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #4fd1e8;
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: #4f8fe8;
    border-radius: 2px;
}

/* --- Buttons --- */
QPushButton {
    background-color: #1a2338;
    border: 1px solid #2a3550;
    border-radius: 6px;
    padding: 7px 14px;
    color: #e7ecf7;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #232f4d;
    border: 1px solid #4f8fe8;
}

QPushButton:pressed {
    background-color: #131a2b;
}

QPushButton#primaryButton {
    background-color: #2c5fd4;
    border: 1px solid #4f8fe8;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #3a6fe0;
}

QPushButton#accentButton {
    background-color: #1d4f4f;
    border: 1px solid #4fd1e8;
    color: #d6fbff;
}

/* --- Tabs --- */
QTabWidget::pane {
    border: 1px solid #1c2436;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background: #0d1220;
    color: #7c869c;
    padding: 8px 16px;
    border: 1px solid #1c2436;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #131a2b;
    color: #4fd1e8;
}

/* --- Tables --- */
QTableWidget {
    background-color: #0d1220;
    alternate-background-color: #101729;
    gridline-color: #1c2436;
    border: 1px solid #1c2436;
    border-radius: 6px;
    color: #c9d3e6;
}

QHeaderView::section {
    background-color: #131a2b;
    color: #97a3ba;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #1c2436;
    font-weight: 600;
}

QTableWidget::item:selected {
    background-color: #2c5fd4;
}

/* --- Text areas --- */
QTextBrowser, QTextEdit {
    background-color: #0d1220;
    border: 1px solid #1c2436;
    border-radius: 8px;
    padding: 10px;
    color: #c9d3e6;
}

QScrollBar:vertical {
    background: #0a0e17;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #262f47;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #3a4666;
}

QListWidget {
    background-color: #0d1220;
    border: 1px solid #1c2436;
    border-radius: 6px;
    color: #c9d3e6;
}

QListWidget::item {
    padding: 8px 10px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #2c5fd4;
    color: #ffffff;
}

QCheckBox, QRadioButton {
    spacing: 6px;
}

QGroupBox {
    border: 1px solid #1c2436;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    color: #97a3ba;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}
